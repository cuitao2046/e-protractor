/* pages/index/index.wxss — iOS 指南针风格 */
.page {
  height: 100vh;
  background: #000000;
  position: relative;
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
}

.swiper {
  width: 100%;
  height: 100%;
}

.page-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* ============ 指南针页 ============ */
.compass-page {
  justify-content: center;
  padding-top: 0;
  position: relative;
}

.dial-area {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 0;
}

/* 真北/磁北切换药丸（罗盘页顶部居中） */
.tn-toggle {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.tn-toggle text {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.6);
  letter-spacing: 2rpx;
}
.tn-toggle.on {
  background: #0A84FF;
}
.tn-toggle.on text {
  color: #FFFFFF;
}

/* 按位置算磁偏角开关（罗盘页顶部居中，真北药丸下方） */
.geo-toggle {
  position: absolute;
  top: calc(76rpx + env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.geo-toggle text {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.6);
  letter-spacing: 2rpx;
}
.geo-toggle.on {
  background: #30D158;
}
.geo-toggle.on text {
  color: #FFFFFF;
}
/* 磁偏角来源小字（实时定位 / 缓存位置 / 默认） */
.geo-source {
  position: absolute;
  top: calc(128rpx + env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  display: flex;
  align-items: center;
  justify-content: center;
}
.geo-source text {
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  opacity: 0.85;
}
.geo-source.geo-live text { color: #30D158; }
.geo-source.geo-cached text { color: #FFD60A; }
.geo-source.geo-default text { color: rgba(255,255,255,0.45); }
.geo-toggle.on text {
  color: #FFFFFF;
}

/* 方位大读数 */
.heading-readout {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  margin-top: 100rpx;
  line-height: 1;
}
.heading-value {
  font-size: 140rpx;
  font-weight: 100;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
  letter-spacing: -4rpx;
}
.heading-cardinal {
  font-size: 68rpx;
  font-weight: 300;
  color: #FFFFFF;
  margin-left: 16rpx;
}
/* 罗盘校准中占位（首屏 / 切后台恢复瞬间，避免显示无效陀螺仪读数） */
.heading-calibrating {
  font-size: 64rpx;
  font-weight: 300;
  color: rgba(255,255,255,0.55);
  letter-spacing: 4rpx;
}

/* 指针与基准的相对读数（锁定基准时显示，绝对定位不挤压布局） */
.relative-readout {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.relative-readout text {
  font-size: 56rpx;
  font-weight: 300;
  color: #E60012;
  font-variant-numeric: tabular-nums;
}

/* ============ 水平仪页 ============ */
.level-page {
  justify-content: center;
}
.level-area {
  display: flex;
  align-items: center;
  justify-content: center;
}
.tilt-readout {
  margin-top: 80rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}
.tilt-value {
  font-size: 120rpx;
  font-weight: 100;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}
.level-hint {
  margin-top: 16rpx;
}
.level-hint text {
  font-size: 34rpx;
  color: #30D158;
}

/* ============ 页面指示点 ============ */
.page-dots {
  position: absolute;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 14rpx;
  z-index: 10;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  transition: all 0.2s ease;
}
.dot.active {
  background: rgba(255,255,255,0.9);
}

/* ============ 右下角历史入口（三道杠） ============ */
.menu-btn {
  position: absolute;
  right: 36rpx;
  bottom: calc(90rpx + env(safe-area-inset-bottom));
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  z-index: 20;
}
.menu-line {
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

/* ============ 历史记录面板 ============ */
.history-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}
.history-panel {
  width: 100%;
  max-height: 65vh;
  background: #1C1C1E;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.history-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.12);
}
.history-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.history-clear {
  font-size: 28rpx;
  color: #FF453A;
  margin-right: 32rpx;
}
.history-close {
  font-size: 36rpx;
  color: #FFFFFF;
}
.history-list {
  margin-top: 16rpx;
  max-height: 48vh;
}
.history-empty {
  text-align: center;
  color: rgba(255,255,255,0.4);
  font-size: 28rpx;
  padding: 60rpx 0;
}
.history-item {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}
.history-item-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.history-time {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
}
.history-delta {
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.history-delta.pos {
  color: #30D158;
}
.history-delta.neg {
  color: #FF453A;
}
.history-base {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}
