/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 48rpx;
}
.status-text {
  font-size: 24rpx;
  color: #6b7280;
  font-variant-numeric: tabular-nums;
}
.baseline-pill {
  font-size: 22rpx;
  color: #6b7280;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #2c2c2e;
}
.baseline-pill.locked {
  color: #f59e0b;
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
}

.dial-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 0;
  padding: 20rpx 0;
}

.bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 12rpx;
}

.readout {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  line-height: 1;
}
.readout-value {
  font-size: 136rpx;
  font-weight: 300;
  letter-spacing: -2rpx;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}
.readout-value.snap { color: #4ade80; }
.readout-value.hold { color: #f59e0b; }

.readout-cardinal {
  margin-left: 18rpx;
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 500;
  color: #ffffff;
}

.readout-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #9ca3af;
  text-align: center;
}
.readout-subtitle.warn {
  color: #fbbf24;
}

.gesture-hint {
  margin-top: 40rpx;
  padding: 0 20rpx;
  text-align: center;
}
.gesture-hint text {
  font-size: 22rpx;
  color: #4b5563;
  line-height: 1.5;
}
