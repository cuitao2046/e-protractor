/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: calc(88rpx + env(safe-area-inset-top)) 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 顶部栏：左汉堡 / 右基准+统计 —— */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  min-height: 72rpx;
}

.hamburger {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
}
.hamburger .bar {
  height: 4rpx;
  width: 40rpx;
  background: #e5e5ea;
  border-radius: 2rpx;
}
.hamburger.hover .bar {
  background: #9ca3af;
}

.top-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.baseline-pill {
  font-size: 22rpx;
  color: #6b7280;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #2c2c2e;
}
.baseline-pill.locked {
  color: #f59e0b;
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
}
.stats-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
  font-variant-numeric: tabular-nums;
}

/* —— 罗盘 —— */
.dial-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 0;
  padding: 16rpx 0;
}

/* —— 底部读数 —— */
.bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 8rpx;
}
.readout {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  line-height: 1;
}
.readout-value {
  font-size: 144rpx;
  font-weight: 200;
  letter-spacing: -2rpx;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}
.readout-value.snap { color: #4ade80; }
.readout-value.hold { color: #f59e0b; }

.readout-cardinal {
  margin-left: 18rpx;
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 500;
  color: #ffffff;
}

.readout-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #9ca3af;
  text-align: center;
}
.readout-subtitle.warn {
  color: #fbbf24;
}

.gesture-hint {
  margin-top: 40rpx;
  padding: 0 20rpx;
  text-align: center;
}
.gesture-hint text {
  font-size: 22rpx;
  color: #4b5563;
  line-height: 1.5;
}
