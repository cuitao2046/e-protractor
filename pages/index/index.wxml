<!-- pages/index/index.wxml -->
<view class="page" bindtap="onPageTap" bindlongpress="onPageLongPress">
  <!-- 顶部状态（仅展示记录数，不拦截手势） -->
  <view class="status-bar">
    <text class="status-text">记录 {{recordCount}}/1000</text>
  </view>

  <!-- 指南针式罗盘盘面 -->
  <view class="dial-area">
    <protractor-dial angle="{{smoothAngle}}" isSnap="{{isSnap}}" holdLatched="{{holdLatched}}" />
  </view>

  <!-- 底部大读数 -->
  <view class="bottom">
    <view class="readout" catchtap="onReadoutTap">
      <text class="readout-value {{isSnap ? 'snap' : (holdLatched ? 'hold' : '')}}">{{displayValue}}</text>
      <text class="readout-cardinal">{{cardinalText}}</text>
    </view>
    <text class="readout-subtitle {{isTiltWarning ? 'warn' : ''}}">{{statusText}}</text>

    <view class="gesture-hint">
      <text>单击屏幕 开始/停止 · 长按 设基准 · 双击 记录 · 点击读数 切换单位</text>
    </view>
  </view>
</view>
