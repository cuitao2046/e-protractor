<!-- pages/index/index.wxml -->
<view class="page">

  <!-- 顶部：左 汉堡菜单(历史) · 右 基准胶囊 + 统计 -->
  <view class="top-bar">
    <view class="hamburger" bindtap="goHistory" hover-class="hover" hover-stay-time="80">
      <view class="bar"></view>
      <view class="bar"></view>
      <view class="bar"></view>
    </view>

    <view class="top-right">
      <view class="baseline-pill {{baselineSet ? 'locked' : ''}}">{{baselineSet ? '基准 已锁定' : '基准 未设'}}</view>
      <text class="stats-text">记录 {{recordCount}}/1000</text>
    </view>
  </view>

  <!-- 罗盘（单击设基准，双击记录历史） -->
  <view class="dial-area" catchtap="onDialTap">
    <protractor-dial phoneHeading="{{phoneHeading}}" baselineAngle="{{baselineAngle}}" isSnap="{{isSnap}}" baselineSet="{{baselineSet}}" />
  </view>

  <!-- 底部读数（单击切换度/弧度） -->
  <view class="bottom">
    <view class="readout" catchtap="onReadoutTap">
      <text class="readout-value {{isSnap ? 'snap' : ''}}">{{displayValue}}</text>
      <text class="readout-cardinal">{{cardinalText}}</text>
    </view>
    <text class="readout-subtitle">{{statusText}}</text>
  </view>
</view>
