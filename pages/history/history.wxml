<!-- pages/history/history.wxml -->
<view class="page">
  <view class="head">
    <view class="head-info">
      <text class="count">{{count}}</text>
      <text class="count-total">/ {{max}} 条</text>
    </view>
    <view class="head-btns">
      <view class="mini-btn" bindtap="onExport">导出CSV</view>
      <view class="mini-btn danger" bindtap="onClear">清空</view>
    </view>
  </view>

  <view wx:if="{{count === 0}}" class="empty">
    <text class="empty-icon">📐</text>
    <text class="empty-text">还没有记录，去测量页记一笔吧</text>
  </view>

  <scroll-view wx:else scroll-y class="list" enhanced show-scrollbar="{{false}}">
    <view class="row" wx:for="{{records}}" wx:key="id">
      <view class="row-main">
        <text class="row-angle">{{item.angleDeg}}°</text>
        <view class="row-meta">
          <text class="row-time">{{item.formattedTime}}</text>
          <text wx:if="{{item.note}}" class="row-note">{{item.note}}</text>
        </view>
      </view>
      <view class="row-del" data-id="{{item.id}}" bindtap="onDelete">删除</view>
    </view>
    <view class="list-foot">仅本地存储 · 超出 1000 条自动循环清理最早记录</view>
  </scroll-view>
</view>
